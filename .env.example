# Pfad, unter dem die Seite innerhalb der Domain liegt.
# Leer lassen, solange die Seite im Root einer Domain liegt (Normalfall).
# Beispiel für ein Unterverzeichnis: /kanzlei
NEXT_PUBLIC_BASE_PATH=

# Öffentliche Adresse der Seite ohne abschließenden Slash.
# Wird für SEO, Sitemap und OpenGraph verwendet.
# Beispiel: https://www.fundstelle.de
NEXT_PUBLIC_SITE_URL=
